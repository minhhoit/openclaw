    }
  ],
  "compliance_policy": {
    "cj": "policy/cj-affiliate-2026.md",
    "shopify": "policy/shopify-terms-2026.md"
  },
  "git_sync": {
    "pre_operation": "git -C \"C:\\Users\\Admins\\.openclaw\\workspace\\repos\\gearpickle\" pull --rebase",
    "post_operation": "git -C \"C:\\Users\\Admins\\.openclaw\\workspace\\repos\\gearpickle\" commit -am \"[AUTO] Daily ops $(Get-Date -Format 'yyyyMMdd-HHmm')\" --allow-empty && git push"
  }
}