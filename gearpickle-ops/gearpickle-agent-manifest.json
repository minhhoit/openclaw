{
  "agent_role": "GearPickle Operator",
  "owned_workspace": "gearpickle-ops/",
  "order_sources": [
    {
      "type": "cj",
      "path": "gearpickle-ops/cj-exports/*.csv",
      "required_fields": ["order_id", "status", "items", "sub_id"]
